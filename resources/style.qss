/* STD shell. Near-black glass, cyan readouts, amber for transmit and warnings. */

QMainWindow, QWidget#textPanel, QWidget#macroRow, QWidget#statusStrip, QWidget#modeProfile,
QWidget#mshvProfile {
  background: #06090e;
  color: #cdd9e5;
}

QMenuBar {
  background: #06090e;
  color: #cdd9e5;
  border-bottom: 1px solid #1a2e3c;
  spacing: 2px;
  padding: 2px 6px;
}

QMenuBar::item {
  background: transparent;
  padding: 4px 10px;
  border-radius: 4px;
}

QMenuBar::item:selected {
  background: #12202c;
  color: #00e5ff;
}

QMenu {
  background: #0c141c;
  color: #cdd9e5;
  border: 1px solid #274150;
  padding: 4px 0;
}

QMenu::item {
  padding: 5px 22px;
}

QMenu::item:selected {
  background: #123040;
  color: #00e5ff;
}

QMenu::separator {
  height: 1px;
  background: #274150;
  margin: 4px 8px;
}

QToolBar#brandBar {
  background: #06090e;
  border: none;
  border-bottom: 1px solid #1a2e3c;
  spacing: 0;
  padding: 0;
}

QLabel#brandSubtitle {
  color: #d5e2ee;
}

QWidget#waterfallTone {
  background: #0c141c;
  border-top: 1px solid #274150;
}

QLabel#waterfallToneLabel {
  color: #9fb4c4;
  background: transparent;
}

QLabel#waterfallToneValue,
QLabel#waterfallFloorValue,
QLabel#waterfallRangeValue {
  color: #00e5ff;
  background: transparent;
}

QWidget#waterfallTone QSlider::groove:horizontal {
  height: 4px;
  background: #1a2e3c;
  border-radius: 2px;
}

QWidget#waterfallTone QSlider::handle:horizontal {
  background: #00e5ff;
  border: none;
  width: 12px;
  margin: -6px 0;
  border-radius: 6px;
}

QToolButton#waterfallPalette {
  background: #121a24;
  color: #d7e6f2;
  border: 1px solid #274150;
  border-radius: 4px;
  padding: 2px 12px 2px 8px;
  min-width: 88px;
}

QToolButton#waterfallPalette:hover {
  border-color: #00e5ff;
  color: #00e5ff;
}

QDockWidget {
  color: #8ea6b8;
  font-size: 11px;
}

QMainWindow::separator {
  background: #12202a;
  width: 4px;
  height: 4px;
}

QMainWindow::separator:hover {
  background: rgba(0, 229, 255, 110);
}

QWidget#dockTitle {
  background: #0b1219;
  border: 1px solid #1e3344;
  border-bottom: 1px solid rgba(0, 229, 255, 70);
}

QWidget#dockTitle QLabel {
  color: #8ea6b8;
  background: transparent;
  border: none;
}

QPushButton#decodeClear, QPushButton#clrRx, QPushButton#clrTx, QPushButton#macroTx,
QPushButton#txClrQueue, QPushButton#txClrNow, QPushButton#txUseFree {
  padding: 1px 8px;
  border-radius: 4px;
}

QSpinBox#txQueueLimit, QSpinBox#txSlots, QSpinBox#txMaxPeriods {
  padding: 0 2px;
  min-height: 18px;
}

QDockWidget::title {
  background: #0b1219;
  border: 1px solid #1e3344;
  border-bottom: 1px solid rgba(0, 229, 255, 70);
  padding-left: 10px;
  padding-top: 5px;
  padding-bottom: 5px;
  text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
  background: transparent;
  border: none;
  padding: 0;
}

QLineEdit, QSpinBox {
  background: #080d13;
  color: #d7e6f2;
  border: 1px solid #1c3344;
  border-radius: 4px;
  padding: 3px 6px;
  min-height: 22px;
}

QSpinBox#profileSpeed, QSpinBox#profileStart, QSpinBox#profileBandwidth,
QSpinBox#rxGain, QSpinBox#txGain, QSpinBox#squelchLevel {
  padding: 0 2px;
  min-height: 18px;
}

QPushButton#afcToggle, QPushButton#squelchToggle, QPushButton#wfAfc, QPushButton#wfSql {
  background: #101820;
  color: #00e5ff;
  border: 1px solid #274150;
  border-radius: 4px;
  padding: 0 8px;
  min-width: 36px;
}

QPushButton#afcToggle:disabled, QPushButton#squelchToggle:disabled,
QPushButton#wfAfc:disabled, QPushButton#wfSql:disabled {
  color: #6d8496;
  background: #0c1218;
}

QPushButton#squelchToggle:checked, QPushButton#wfSql:checked {
  background: #245068;
  color: #f4fdff;
}

/* Waterfall Auto and Flatten: a dim frame when off, a bright cyan frame
   and fill when on, so the state reads at a glance. AFC on the same bar
   gets the same on look. */
QPushButton#waterfallAuto, QPushButton#waterfallFlatten {
  background: #101820;
  color: #6d8496;
  border: 1px solid #274150;
  border-radius: 4px;
  padding: 0 8px;
  min-width: 44px;
}

QPushButton#waterfallAuto:checked, QPushButton#waterfallFlatten:checked,
QPushButton#wfAfc:checked {
  background: #1d5a73;
  color: #ffffff;
  border: 2px solid #00e5ff;
}

QPushButton#waterfallAuto:hover, QPushButton#waterfallFlatten:hover {
  border-color: #00e5ff;
}

QPushButton {
  background: #121a24;
  color: #d7e6f2;
  border: 1px solid #274150;
  border-radius: 6px;
  padding: 5px 12px;
}

QPushButton:hover {
  border-color: #00e5ff;
  color: #00e5ff;
}

QPushButton:disabled {
  color: #5c7284;
  border-color: #1c3344;
}

QPlainTextEdit, QTextEdit, QListWidget {
  background: #080d13;
  color: #d7e6f2;
  border: 1px solid #1c3344;
  border-radius: 6px;
  selection-background-color: rgba(0, 229, 255, 60);
  selection-color: #f2fbff;
  padding: 4px;
}

QPlainTextEdit#transmitText {
  background: #100e0c;
  border: 1px solid rgba(224, 138, 61, 90);
}

QLabel#panelNote, QLabel#macroEmpty {
  color: #6d8496;
}

QLabel#decodeHeader, QLabel#wsprRxHeader {
  color: #9fb4c4;
  padding: 0;
  margin: 0;
  background: transparent;
}

QPlainTextEdit#receiveText, QTextEdit#rxEcho {
  padding: 4px;
}

QLabel#readoutLabel {
  color: #6d8496;
}

QLabel#modeValue, QLabel#afcValue, QLabel#squelchValue, QLabel#dialValue {
  color: #00e5ff;
}

QLabel#radioState, QLabel#radioDot {
  color: #e08a3d;
}

QLabel#txGainHot {
  color: #2a1404;
  background: #e08a3d;
  padding: 2px 8px;
  border-radius: 3px;
}

QFrame#statusSep {
  background: #274150;
  max-width: 1px;
  margin: 6px 2px;
}

QPushButton#macro {
  background: #101820;
  color: #8ea3b5;
  border: 1px dashed #2a4254;
  border-radius: 6px;
  min-width: 46px;
  min-height: 26px;
  padding: 2px 8px;
}

QPushButton#profileBand {
  background: #101820;
  color: #cdd9e5;
  border: 1px solid #274150;
  border-radius: 4px;
  min-width: 36px;
  min-height: 24px;
  padding: 1px 6px;
}

QPushButton#profileBand:checked {
  background: #143024;
  color: #b6f5c8;
  border: 1px solid #3ddc84;
}

QPushButton#profileBand:hover {
  border-color: #3d6a84;
}

QLabel#keyboardProfile {
  color: #8ea3b5;
  padding: 8px 10px;
}

QPushButton#macro:disabled {
  background: #0c1218;
  color: #4d6272;
  border: 1px dashed #243848;
}

QScrollBar:vertical {
  background: #080d13;
  width: 10px;
  margin: 2px;
}

QScrollBar::handle:vertical {
  background: #3d5a6e;
  border-radius: 4px;
  min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
  background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}

QScrollBar:horizontal {
  background: #080d13;
  height: 10px;
  margin: 2px;
}

QScrollBar::handle:horizontal {
  background: #3d5a6e;
  border-radius: 4px;
  min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
  background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

QToolTip {
  background: #0f1720;
  color: #cdd9e5;
  border: 1px solid #274150;
  padding: 4px 6px;
}

/* Tx line markers: a biohazard sign. Glowing toxic green on the line that
   goes out next, a dim one on the others. Drawn by make-biohazard.py. */
QRadioButton#txPick1::indicator,
QRadioButton#txPick2::indicator,
QRadioButton#txPick3::indicator,
QRadioButton#txPick4::indicator,
QRadioButton#txPick5::indicator,
QRadioButton#txPick6::indicator,
QRadioButton#txPick7::indicator {
  width: 18px;
  height: 18px;
  image: url(:/std/biohazard-off.svg);
}

QRadioButton#txPick1::indicator:hover,
QRadioButton#txPick2::indicator:hover,
QRadioButton#txPick3::indicator:hover,
QRadioButton#txPick4::indicator:hover,
QRadioButton#txPick5::indicator:hover,
QRadioButton#txPick6::indicator:hover,
QRadioButton#txPick7::indicator:hover {
  image: url(:/std/biohazard-hover.svg);
}

QRadioButton#txPick1::indicator:checked,
QRadioButton#txPick2::indicator:checked,
QRadioButton#txPick3::indicator:checked,
QRadioButton#txPick4::indicator:checked,
QRadioButton#txPick5::indicator:checked,
QRadioButton#txPick6::indicator:checked,
QRadioButton#txPick7::indicator:checked {
  image: url(:/std/biohazard-on.svg);
}

/* JS8 top bar: clock, offset, filter, picked station and the RX/TX lamps. */
QLabel#js8Utc, QLabel#js8To {
  color: #00e5ff;
}

QLabel#js8Date, QLabel#js8StripLabel, QCheckBox#js8Filter {
  color: #9fb4c4;
}

QLabel#js8RxLamp, QLabel#js8TxLamp {
  background: #101820;
  color: #4d6272;
  border: 1px solid #274150;
  border-radius: 4px;
}

QLabel#js8RxLamp[lit="true"] {
  background: #143024;
  color: #b6f5c8;
  border: 1px solid #3ddc84;
}

QLabel#js8TxLamp[lit="true"] {
  background: #e08a3d;
  color: #2a1404;
  border: 1px solid #ffb36b;
}

QTreeWidget#js8BandActivity, QTreeWidget#js8CallActivity, QTextEdit#js8Conversation {
  background: #080d13;
  color: #d7e6f2;
  border: 1px solid #1c3344;
  border-radius: 6px;
  selection-background-color: rgba(0, 229, 255, 60);
  selection-color: #f2fbff;
}

QTreeWidget#js8BandActivity QHeaderView::section,
QTreeWidget#js8CallActivity QHeaderView::section {
  background: #0b1219;
  color: #9fb4c4;
  border: none;
  border-right: 1px solid #1c3344;
  border-bottom: 1px solid #1c3344;
  padding: 3px 6px;
}

QToolButton#js8Directed {
  background: #121a24;
  color: #d7e6f2;
  border: 1px solid #274150;
  border-radius: 6px;
  padding: 5px 18px 5px 12px;
}

QToolButton#js8Directed:hover {
  border-color: #00e5ff;
  color: #00e5ff;
}

QToolButton#js8Directed:disabled {
  color: #5c7284;
  border-color: #1c3344;
}

QCheckBox#js8Filter::indicator {
  width: 14px;
  height: 14px;
  background: #080d13;
  border: 1px solid #3d6a84;
  border-radius: 3px;
}

QCheckBox#js8Filter::indicator:hover {
  border-color: #00e5ff;
}

QCheckBox#js8Filter::indicator:checked {
  background: #00e5ff;
  border-color: #00e5ff;
}

/* WEFAX frequency outside its published hours: dimmed, still clickable. */
QPushButton#wefaxFreq[offAir="true"] {
  color: #5c7284;
  border: 1px dashed #274150;
}

/* Keyboard-mode QSO bar. */
QLabel#qsoBarLabel { color: #8fa6b8; }
QLabel#qsoBarOn { color: #8fa6b8; padding: 0 4px; }
QLabel#qsoBarRstTag { font-size: 10px; text-transform: uppercase; padding: 0 2px; }
QLabel#qsoBarRstTag[state="auto"] { color: #4ade80; }
QLabel#qsoBarRstTag[state="manual"] { color: #8fa6b8; }
QLabel#qsoBarRstTag[state="off"] { color: #c08040; }
QPushButton#qsoBarLog { min-width: 52px; }
